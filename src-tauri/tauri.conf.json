{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Skill Manager",
  "version": "0.2.1",
  "identifier": "com.agentskillmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Skill Manager",
        "visible": true,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1RDRBNTUyQTlGRjYzMkQKUldRdFkvK3BVcVhVUmZLVWFXempUWS9WMWp6RUpaaTBMYS9kUXRCYitPM1VuRUVsNFErSUJvT1QK",
      "endpoints": [
        "https://github.com/longl1005/agent-skill-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
